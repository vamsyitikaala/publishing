# Node artifact files
node_modules/
dist/

# Log files
*.log

# Test-run artifacts — regenerated every run, never committed.
/test-results/
/playwright-report/
/reports/performance/
/screenshots/

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Environment credentials — never commit real URLs/logins.
# .env.example is the only tracked template.
.env
.env.*
.env.local
!.env.example
